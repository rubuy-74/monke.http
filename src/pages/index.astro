---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusCard from '../components/StatusCard.astro';
import { getVisibleStatuses } from '../lib/visible-statuses';
import { ArrowUpRight, Check, Copy, X } from '@lucide/astro';

const groupsNums = ['1XX', '2XX', '3XX', '4XX', '5XX'];
const groups = ['Informational', 'Success', 'Redirection', 'Client errors', 'Server errors'];
const colors = ['text-[#6b9ed0]', 'text-[#78a966]', 'text-[#e0ae40]', 'text-[#d4b42d]', 'text-[#947711]'];
const statuses = await getVisibleStatuses();
const exampleCode = statuses.some(status => status.code === 404) ? '404' : String(statuses[0]?.code ?? '404');
const usageOrigin = import.meta.env.DEV ? Astro.url.origin : 'https://monke.http.rubuy.me';
---
<BaseLayout title="monke.http">
  <main class="mx-auto w-full max-w-[1120px] px-5 pb-20 max-[760px]:px-3.5">
    <section class="py-8" aria-labelledby="usage-heading">
      <h1 id="usage-heading" class="mb-4 text-xl font-semibold">Usage:</h1>
      <form id="usage-form" action="/go" method="get" class="flex flex-wrap items-center justify-between gap-4 rounded-sm border border-[#e5d8c9] bg-[#fffaf2] px-4 py-5 dark:border-[#4a3a32] dark:bg-[#2a221f]">
        <div class="flex min-w-0 flex-wrap items-center gap-y-2 font-mono text-sm sm:text-base">
          <span class="break-all">{usageOrigin}/</span>
          <label class="sr-only" for="status-code">HTTP status code</label>
          <input id="status-code" name="code" type="text" inputmode="numeric" pattern="[1-5][0-9]{2}" minlength="3" maxlength="3" value={exampleCode} required aria-describedby="status-code-help" autocomplete="off" spellcheck="false" class="w-[3.5ch] min-w-0 appearance-none rounded-none border-0 border-b border-transparent bg-transparent p-0 font-[inherit] text-[inherit] leading-[inherit] text-[#947711] caret-[#947711] outline-none selection:bg-[#ffe135]/30 hover:border-[#947711]/40 focus:border-[#947711] dark:text-[#ffe135] dark:caret-[#ffe135] dark:hover:border-[#ffe135]/40 dark:focus:border-[#ffe135]" />
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <button id="copy-url" type="button" class="flex size-10 cursor-pointer items-center justify-center rounded-sm border border-[#d7c6b8] text-[#6f5b50] hover:bg-[#ffe135]/15 focus-visible:outline-2 focus-visible:outline-offset-4 dark:border-[#695347] dark:text-[#ffe135]" aria-label="Copy selected image URL" title="Copy URL"><span id="copy-icon"><Copy size={19} aria-hidden="true" /></span><span id="copied-icon" class="hidden"><Check size={19} aria-hidden="true" /></span></button>
          <button type="submit" class="inline-flex h-10 cursor-pointer items-center gap-2 rounded-sm bg-[#ffe135] px-4 font-mono text-sm font-bold text-[#33251f] hover:bg-[#efd02c] focus-visible:outline-2 focus-visible:outline-offset-4">Go <ArrowUpRight size={17} aria-hidden="true" /></button>
        </div>
      </form>
      <p id="status-code-help" class="mt-2 text-xs text-[#816d60] dark:text-[#cbb7a8]">Enter a status code to open its image.</p>
      <p id="copy-feedback" class="sr-only mt-2 text-xs text-[#816d60] dark:text-[#cbb7a8]" role="status"></p>
    </section>

    <div>
      {groups.map((group, index) => statuses.some(status => status.group === group) && (
        <section class="mb-16 max-[760px]:mb-[46px]" aria-labelledby={group.toLowerCase().replace(' ', '-')}>
					<h2 class="mb-[19px] flex items-center gap-[11px] font-mono text-[.75rem] font-medium uppercase tracking-[.08em] text-[#816d60] dark:text-[#cbb7a8]" id={group.toLowerCase().replace(' ', '-')}><span class:list={[colors[index]]}>{groupsNums[index]}</span>{group}</h2>
          <div class="grid grid-cols-4 gap-4 max-[760px]:grid-cols-2 max-[760px]:gap-3">
            {statuses.filter((status) => status.group === group).map((status) => <StatusCard status={status} />)}
          </div>
        </section>
      ))}
    </div>
    {statuses.length === 0 && <p class="py-12 text-[#816d60] dark:text-[#cbb7a8]">No monkey pictures published yet. Check back soon.</p>}

    <dialog id="status-dialog" aria-labelledby="dialog-title" class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-[680px] overflow-y-auto border border-[#e5d8c9] bg-[#fffaf2] p-5 text-[#33251f] backdrop:bg-black/70 dark:border-[#4a3a32] dark:bg-[#2a221f] dark:text-[#f8f2e9]">
      <div class="mb-4 flex items-center justify-between gap-4">
        <h2 id="dialog-title" class="font-mono text-lg font-semibold"></h2>
        <form method="dialog"><button class="flex size-9 cursor-pointer items-center justify-center hover:bg-black/5 dark:hover:bg-white/10" aria-label="Close description"><X size={20} aria-hidden="true" /></button></form>
      </div>
      <img id="dialog-image" class="mb-6 block h-[min(48dvh,400px)] w-full bg-[#f8f2e9] object-contain dark:bg-[#1c1816]" alt="" />
      <h3 class="mb-3 text-lg font-semibold">Description</h3>
      <div id="dialog-description" class="space-y-4 leading-relaxed text-[#5d4b40] dark:text-[#d9c8bb]"></div>
      <a id="dialog-source" class="mt-5 inline-block font-mono text-xs text-[#947711] underline dark:text-[#ffe135]">MDN source</a>
    </dialog>

    <footer class="mt-5 border-t border-[#e5d8c9] py-6 text-center font-mono text-xs text-[#9a8576] dark:border-[#4a3a32] dark:text-[#ad9888]">
      <p>made by rubuy with 🐒</p>
    </footer>
  </main>
  <script is:inline define:vars={{ statuses }}>
    const copyButton = document.querySelector('#copy-url');
    const copyIcon = document.querySelector('#copy-icon');
    const copiedIcon = document.querySelector('#copied-icon');
    let copyResetTimer;
    copyButton.addEventListener('click', async () => {
      if (!document.querySelector('#usage-form').reportValidity()) return;
      const feedback = document.querySelector('#copy-feedback');
      const code = document.querySelector('#status-code').value;
      try {
        await navigator.clipboard.writeText(new URL(`/${code}`, window.location.origin).href);
        clearTimeout(copyResetTimer);
        copyIcon.classList.add('hidden');
        copiedIcon.classList.remove('hidden');
        copyButton.setAttribute('aria-label', 'URL copied');
        feedback.classList.add('sr-only');
        feedback.textContent = 'Copied.';
        copyResetTimer = setTimeout(() => {
          copyIcon.classList.remove('hidden');
          copiedIcon.classList.add('hidden');
          copyButton.setAttribute('aria-label', 'Copy selected image URL');
          feedback.textContent = '';
        }, 2000);
      } catch {
        feedback.classList.remove('sr-only');
        feedback.textContent = 'Could not copy. Use Go to open the image and copy its address.';
      }
    });
    const dialog = document.querySelector('#status-dialog');
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    function openStatus(status) {
      if (!status) return;
      document.querySelector('#dialog-title').textContent = `${status.code} ${status.phrase}`;
      const image = document.querySelector('#dialog-image');
      image.src = `/${status.code}`;
      image.alt = `${status.code} ${status.phrase} monkey`;
      document.querySelector('#dialog-description').replaceChildren(...status.description.map(text => {
        const paragraph = document.createElement('p');
        paragraph.textContent = text;
        return paragraph;
      }));
      document.querySelector('#dialog-source').href = status.source;
      if (!dialog.open) dialog.showModal();
    }
    document.querySelectorAll('[data-status-code]').forEach(button => {
      button.addEventListener('click', () => {
        openStatus(statuses.find(status => String(status.code) === button.dataset.statusCode));
      });
    });
    const randomButton = document.querySelector('#random-monkey');
    randomButton.disabled = statuses.length === 0;
    randomButton.addEventListener('click', () => {
      openStatus(statuses[Math.floor(Math.random() * statuses.length)]);
    });
    document.querySelector('#status-code').addEventListener('focus', event => event.target.select());
  </script>
</BaseLayout>
